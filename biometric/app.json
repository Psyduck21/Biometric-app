{
  "expo": {
    "name": "Aegis",
    "slug": "biometric",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "biometric",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "assets/images/**",
      "assets/models/**"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.akshatprj.biometric"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.akshatprj.biometric",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "newArchEnabled": true,
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ],
      "./withLargeHeap.js",
      "./withProductionHarden.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac8275ab-ce48-4bc4-9da2-ef2ef1cb9815"
      }
    },
    "owner": "akshatprj"
  }
}